# Syscon OneTeamOneGoal — environment template.
# Copy to .env.local (git-ignored), fill in what you need, and restart the server.
# Every value here is optional for local development: without them the app runs with
# demo accounts, the offline quiz generator, and the Atlassian sections switched off.

# ── Core ─────────────────────────────────────────────────────────────────────
# Signs session cookies. REQUIRED in production. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Where the database file, uploads and extracted text are stored (default: ./data).
# Point this at persistent, backed-up storage in production.
DATA_DIR=

# Demo accounts "employee" and "admin". Created automatically outside production
# when there are no users; set to false to disable, or true to force in production.
SEED_DEMO_USERS=
DEMO_PASSWORD=

# Largest document an admin may upload, in MB (default 10).
MAX_UPLOAD_MB=

# ── Quiz generation (Level Up) ───────────────────────────────────────────────
# auto (default: Claude when a key is set, otherwise offline) | ai | offline
QUIZ_GENERATOR=auto
# Claude API key for AI-written questions and AS-IS Navigator analysis. Without it,
# questions are built offline and AS-IS findings/decisions are recorded by hand.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5).
ANTHROPIC_MODEL=
# Publish generated quizzes without admin review when they pass validation (default false).
QUIZ_AUTO_PUBLISH=false

# ── Confluence (Confluence Hub, AS-IS Navigator, triage knowledge) ───────────
# Cloud:       CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
#              + CONFLUENCE_EMAIL + CONFLUENCE_API_TOKEN
#              (token from https://id.atlassian.com/manage-profile/security/api-tokens)
# Data Center: CONFLUENCE_BASE_URL=https://confluence.example.com
#              + CONFLUENCE_PAT (personal access token of the integration account)
CONFLUENCE_BASE_URL=
CONFLUENCE_DEPLOYMENT=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAT=
# Optional: limit search to these spaces (comma-separated keys).
CONFLUENCE_SPACE_KEYS=
# Optional: set to false to switch the integration off without removing settings.
CONFLUENCE_ENABLED=

# ── Jira (Jira Tickets, Client Defect Triage, release checks) ────────────────
# Cloud:       JIRA_BASE_URL=https://your-site.atlassian.net + JIRA_EMAIL + JIRA_API_TOKEN
# Data Center: JIRA_BASE_URL=https://jira.example.com + JIRA_PAT
JIRA_BASE_URL=
JIRA_DEPLOYMENT=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PAT=
# Optional: limit search to these projects (comma-separated keys).
JIRA_PROJECT_KEYS=
# JQL that selects client defects for the triage module (default: issuetype = Bug).
JIRA_DEFECT_JQL=
# Optional custom field ids shown on defects, e.g. customfield_10050.
JIRA_CLIENT_FIELD=
JIRA_SEVERITY_FIELD=
JIRA_ENABLED=

# Timeout for Confluence and Jira calls, in milliseconds (default 10000).
INTEGRATION_TIMEOUT_MS=

# Optional: allow one other origin to call the API from a browser.
CORS_ORIGINS=
